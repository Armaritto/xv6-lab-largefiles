#!/usr/bin/env python3

import re
from gradelib import *

r = Runner(save("xv6.out"))

@test(80, "large file: write and read")
def test_bigfile():
    r.run_qemu(shell_script([
        'bigfile'
    ]), timeout=240)
    r.match('^wrote 65803 blocks$')
    r.match('^reading bigfile$')
    r.match('^bigfile done; ok$')

@test(20, "existing regression tests")
def test_usertests():
    r.run_qemu(shell_script([
        "usertests -q"
    ]), timeout=360)
    r.match("^ALL TESTS PASSED$")

run_tests()
